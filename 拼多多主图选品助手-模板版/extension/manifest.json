{
  "manifest_version": 3,
  "name": "拼多多 · 主图选品助手",
  "version": "1.3.0",
  "description": "保存商品名称，按采集网址在拼多多或 1688 搜索，按主图去重并保留同图最低展示价，每个名称最多 20 个商品后导出 Excel。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "downloads"],
  "host_permissions": ["https://mobile.pinduoduo.com/*", "https://*.1688.com/*", "https://1688.com/*", "https://*.alicdn.com/*", "https://*.tmall.com/*"],
  "optional_host_permissions": ["https://*.pddpic.com/*", "https://*.alicdn.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开主图选品助手" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}

{
  "manifest_version": 3,
  "name": "拼多多 · 主图选品助手",
  "version": "1.1.3",
  "description": "保存商品名称，按主图去重、保留同图最低展示价，每个名称收集最多20个商品链接并导出Excel。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "downloads"],
  "host_permissions": ["https://mobile.pinduoduo.com/*"],
  "optional_host_permissions": ["https://*.pddpic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开主图选品助手" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
